{
  "name": "pronosticat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:reset": "node scripts/db-reset.mjs && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up",
    "docker:dev:db": "docker compose -f compose.yaml -f compose.dev.yaml up db",
    "docker:dev:full": "docker compose -f compose.yaml -f compose.dev.yaml --profile full up --build",
    "docker:prod": "docker compose -f compose.yaml -f compose.prod.yaml up -d --build --remove-orphans --wait --wait-timeout 180 app backup cron",
    "docker:prod:down": "docker compose -f compose.yaml -f compose.prod.yaml down",
    "docker:prod:logs": "docker compose -f compose.yaml -f compose.prod.yaml logs -f",
    "docker:prod:backup": "bash scripts/db-backup.sh",
    "docker:prod:restore": "bash scripts/db-restore.sh"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.27",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
