{
  "name": "pronosticat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up",
    "docker:dev:db": "docker compose -f compose.yaml -f compose.dev.yaml up db",
    "docker:dev:full": "docker compose -f compose.yaml -f compose.dev.yaml --profile full up --build",
    "docker:prod": "docker compose -f compose.yaml -f compose.prod.yaml up -d --build",
    "docker:prod:down": "docker compose -f compose.yaml -f compose.prod.yaml down",
    "docker:prod:logs": "docker compose -f compose.yaml -f compose.prod.yaml logs -f"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@ducanh2912/next-pwa": "^10.2.9",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
