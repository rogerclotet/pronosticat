# Database
# Local app + Docker postgres (match POSTGRES_* below; use POSTGRES_PORT when mapped):
DATABASE_URL=postgresql://pronosticat:pronosticat@localhost:5432/pronosticat

# Docker Compose (postgres service)
POSTGRES_USER=pronosticat
POSTGRES_PASSWORD=pronosticat
POSTGRES_DB=pronosticat
POSTGRES_PORT=5432
APP_PORT=3000

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Header carrying the real client IP, used to key auth rate limits. Defaults to
# x-forwarded-for. Only list headers your reverse proxy OVERWRITES — if the app
# is ever reachable directly, a client can forge them. Set to a header nobody
# else can set, or leave empty when there is no proxy in front.
# TRUSTED_IP_HEADERS=x-forwarded-for

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (magic link emails)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Football Data API
FOOTBALL_DATA_API_KEY=

# Cron sync endpoint (required in production; Compose service `cron` calls it every 10 min)
CRON_SECRET=
# CRON_SCHEDULE=*/10 * * * *

# Web Push (PWA). Generate with: pnpm exec web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL. BETTER_AUTH_URL is used when it is https.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional Postgres pool size for the app process (default 10)
# DB_POOL_SIZE=10

# Prod backups (compose.prod sidecar writes here on the host)
# POSTGRES_BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MIN=3
# BACKUP_INTERVAL_SECONDS=86400

# Dev fixtures HTML admin is development-only.
# Production break-glass API routes require DEV_FIXTURES_ENABLED=true AND a secret.
# DEV_FIXTURES_ENABLED=true
# DEV_FIXTURES_SECRET=
