# Database
# Local app + Docker postgres: postgresql://pronosticat:pronosticat@localhost:5432/pronosticat
DATABASE_URL=postgresql://user:password@localhost:5432/pronosticat

# Docker Compose (postgres service)
POSTGRES_USER=pronosticat
POSTGRES_PASSWORD=pronosticat
POSTGRES_DB=pronosticat
POSTGRES_PORT=5432
APP_PORT=3000

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (magic link emails)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Football Data API
FOOTBALL_DATA_API_KEY=

# Cron sync endpoint
CRON_SECRET=
