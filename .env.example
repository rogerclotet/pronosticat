# Database
# Local app + Docker postgres (match POSTGRES_* below; use POSTGRES_PORT when mapped):
DATABASE_URL=postgresql://pronosticat:pronosticat@localhost:5432/pronosticat

# Docker Compose (postgres service)
POSTGRES_USER=pronosticat
POSTGRES_PASSWORD=pronosticat
POSTGRES_DB=pronosticat
POSTGRES_PORT=5432
APP_PORT=3000

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (magic link emails)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Football Data API
FOOTBALL_DATA_API_KEY=

# Cron sync endpoint (required in production)
CRON_SECRET=

# Optional Postgres pool size for the app process (default 10)
# DB_POOL_SIZE=10

# Prod backups (compose.prod sidecar writes here on the host)
# POSTGRES_BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MIN=3
# BACKUP_INTERVAL_SECONDS=86400

# Dev fixtures HTML admin is development-only.
# Production break-glass API routes require DEV_FIXTURES_ENABLED=true AND a secret.
# DEV_FIXTURES_ENABLED=true
# DEV_FIXTURES_SECRET=
